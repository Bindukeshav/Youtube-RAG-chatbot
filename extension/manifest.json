{
  "manifest_version": 3,
  "name": "YouTube Doubt Solver",
  "version": "1.0",
  "description": "Ask questions about the YouTube video you're watching",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://youtube-rag.onrender.com/*"],
  "action": {
    "default_popup": "popup.html"
  }
}
